# Copier en .env pour le développement local. Ne jamais committer .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salon
APP_BASE_URL=http://localhost:8888
APP_ENV=development

# Administrateur unique. Générer le hash avec : npm run admin:hash -- "mot-de-passe-long"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$...remplacer...


# Gmail : validation en deux étapes activée + mot de passe d'application (16 caractères)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Studio Sillage <votre.adresse@gmail.com>"
SALON_INBOX=votre.adresse@gmail.com

# Mode e-mail : smtp (envoi réel) ou log (aucun envoi, journalisation masquée)
MAIL_MODE=smtp
